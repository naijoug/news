{
  "name": "zhaoxi",
  "private": true,
  "version": "1.0.0",
  "description": "朝夕 — a daily Chinese news digest published to GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check": "astro check",
    "dev": "astro dev",
    "build": "npm run validate && astro check && astro build && node scripts/smoke-dist.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "astro": "^7.4.2",
    "typescript": "^6.0.3"
  }
}
