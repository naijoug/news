{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naijoug.github.io/news/schemas/edition.schema.json",
  "title": "Zhaoxi edition",
  "description": "One morning (早报) or evening (晚报) digest. Section keys are fixed ids, not Chinese names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "edition", "sections"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema, for editors. Ignored by the site."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Publication date, YYYY-MM-DD. Must match the filename and be a real calendar date."
    },
    "edition": {
      "type": "string",
      "enum": ["morning", "evening"],
      "description": "morning = 早报, evening = 晚报."
    },
    "sample": {
      "type": "boolean",
      "description": "True only for placeholder editions. Sample editions stay out of the RSS feed and sitemap and are marked noindex."
    },
    "lead": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Optional one- or two-sentence introduction for the whole edition. Omit the key when there is no lead."
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tech", "world", "business", "china"],
      "properties": {
        "tech": { "$ref": "#/$defs/storyList" },
        "world": { "$ref": "#/$defs/storyList" },
        "business": { "$ref": "#/$defs/storyList" },
        "china": { "$ref": "#/$defs/storyList" }
      }
    }
  },
  "$defs": {
    "storyList": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/story" }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "sources"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "minLength": 8,
          "maxLength": 280,
          "description": "One or two sentences."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "url": {
          "type": "string",
          "minLength": 12,
          "maxLength": 2000,
          "pattern": "^https://\\S+$"
        }
      }
    }
  }
}
