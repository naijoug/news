{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naijoug.github.io/news/schemas/edition.schema.json",
  "title": "Zhaoxi day",
  "description": "One calendar day. Put morning stories in am. When afternoon stories exist, add pm to this same file. Do not create a second file. Section keys are fixed ids. Story text is bilingual: originalLang plus title and summary objects with zh and/or en.",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "am"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema, for editors. Ignored by the site."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Publication date, YYYY-MM-DD. Must match the filename and be a real calendar date."
    },
    "sample": {
      "type": "boolean",
      "description": "True only for placeholder days. Sample days stay out of the RSS feed and sitemap and are marked noindex."
    },
    "lead": {
      "$ref": "#/$defs/leadText",
      "description": "Optional bilingual introduction. Omit the key when unused. Do not send an empty object."
    },
    "am": {
      "$ref": "#/$defs/part",
      "description": "Morning stories. Required. Use empty arrays for sections with nothing to report."
    },
    "pm": {
      "$ref": "#/$defs/part",
      "description": "Afternoon stories. Omit this key until they exist, then add it to this same file. If present, it must contain at least one story."
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tech", "world", "business", "china"],
      "properties": {
        "tech": { "$ref": "#/$defs/storyList" },
        "world": { "$ref": "#/$defs/storyList" },
        "business": { "$ref": "#/$defs/storyList" },
        "china": { "$ref": "#/$defs/storyList" }
      }
    },
    "storyList": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/story" }
    },
    "leadText": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "zh": { "type": "string", "minLength": 1, "maxLength": 200 },
        "en": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "titleText": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "zh": { "type": "string", "minLength": 2, "maxLength": 100 },
        "en": { "type": "string", "minLength": 2, "maxLength": 100 }
      }
    },
    "summaryText": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "zh": { "type": "string", "minLength": 8, "maxLength": 280 },
        "en": { "type": "string", "minLength": 8, "maxLength": 280 }
      }
    },
    "bodyText": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Optional longer copy as Markdown. Paragraphs, - lists, **bold**, *em*, and [label](https://...) links only.",
      "properties": {
        "zh": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "en": { "type": "string", "minLength": 1, "maxLength": 6000 }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originalLang", "title", "summary", "sources"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable slug, unique inside this day. Used in the story URL. Do not rename it after publish."
        },
        "originalLang": {
          "type": "string",
          "enum": ["zh", "en"],
          "description": "Language the story was written in. zh or en."
        },
        "title": { "$ref": "#/$defs/titleText" },
        "summary": { "$ref": "#/$defs/summaryText" },
        "body": { "$ref": "#/$defs/bodyText" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "minLength": 12,
          "maxLength": 2000,
          "pattern": "^https://\\S+$"
        },
        "lang": {
          "type": "string",
          "enum": ["zh", "en"],
          "description": "Optional language of the source page."
        }
      }
    }
  }
}
