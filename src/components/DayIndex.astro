---
import InkLabel from './InkLabel.astro';
import UiText from './UiText.astro';
import { dayPath, sectionById, sectionPath, storyPath, type Day } from '../lib/editions';
import { href } from '../lib/urls';

interface Props {
  days: Day[];
}

const { days } = Astro.props;
const PREVIEW = 8;
---

<ol class="day-index">
  {
    days.map((day) => {
      const shown = day.stories.slice(0, PREVIEW);
      const more = day.stories.length - shown.length;
      const dayNumber = String(Number(day.date.slice(8)));
      return (
        <li class="day-row">
          <div class="day-mast">
            <h2>
              <a href={href(dayPath(day))}>
                <time datetime={day.date}>
                  <span class="day-num" aria-hidden="true">
                    {dayNumber}
                  </span>
                  <span class="day-meta">
                    <span class="day-literary">
                      <UiText zh={day.literaryDate} en={day.dayLabelEn} />
                    </span>
                    <span class="day-weekday">
                      <UiText zh={day.weekday} en={day.weekdayEn} />
                    </span>
                    <span class="day-date">
                      <UiText zh={day.dateLabel} en={day.dateLabelEn} />
                    </span>
                  </span>
                </time>
              </a>
              {day.sample && (
                <span class="pill">
                  <UiText zh="示例" en="Sample" />
                </span>
              )}
            </h2>
          </div>
          <div class="day-body">
          <ul class="headline-list">
            {shown.map((story) => {
              const section = sectionById(story.sectionId);
              const hasZh = Boolean(story.title.zh);
              const hasEn = Boolean(story.title.en);
              return (
                <li class="headline-row">
                  {section && (
                    <InkLabel class="headline-tag" href={href(sectionPath(section.id))} sectionId={section.id}>
                      <UiText zh={section.name.zh} en={section.name.en} />
                    </InkLabel>
                  )}
                  <a class="headline-title" href={href(storyPath(story))}>
                    <span
                      class="copy"
                      data-original={story.originalLang}
                      data-has-zh={hasZh ? '' : undefined}
                      data-has-en={hasEn ? '' : undefined}
                    >
                      {hasZh && (
                        <span class="t-zh" lang="zh-Hans">
                          {story.title.zh}
                        </span>
                      )}
                      {hasEn && (
                        <span class="t-en" lang="en">
                          {story.title.en}
                        </span>
                      )}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
          {more > 0 && (
            <p class="more-count">
              <a href={href(dayPath(day))}>
                <UiText zh={`还有 ${more} 则`} en={`+${more} more`} />
              </a>
            </p>
          )}
          </div>
        </li>
      );
    })
  }
</ol>
