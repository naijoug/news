---
import {
  SECTIONS,
  editionPath,
  sectionPath,
  type Edition,
} from '../lib/editions';
import { href } from '../lib/urls';
import StoryItem from './StoryItem.astro';

interface Props {
  edition: Edition;
  older: Edition | null;
  newer: Edition | null;
  showPermalink?: boolean;
}

const { edition, older, newer, showPermalink = false } = Astro.props;
---

<article class="edition">
  {
    edition.sample && (
      <p class="sample-banner" role="note">
        示例刊。本页条目是占位，用来核对版式，不是真实报道。
      </p>
    )
  }
  {!newer && <p class="kicker">最新</p>}
  <header class="edition-head">
    <h1>
      <span class="h1-date">
        <time datetime={edition.date}>{edition.dateLabel}</time>
        <span aria-hidden="true"> · </span>
        {edition.weekday}
      </span>
      <span class="h1-kind">{edition.editionLabel}</span>
    </h1>
    {edition.lead && <p class="lead">{edition.lead}</p>}
    {
      showPermalink && (
        <p class="permalink">
          <a href={href(editionPath(edition))}>本刊固定链接</a>
        </p>
      )
    }
  </header>
  <nav class="toc" aria-label="本期栏目">
    {
      SECTIONS.map((section) => (
        <a href={`#${section.id}`}>{section.name}</a>
      ))
    }
  </nav>
  {
    SECTIONS.map((section, index) => {
      const stories = edition.sections[section.id] ?? [];
      return (
        <section class="edition-section" id={section.id}>
          <header class="section-head">
            <span class="section-index">{String(index + 1).padStart(2, '0')}</span>
            <h2>
              <a href={href(sectionPath(section.id))}>{section.name}</a>
            </h2>
          </header>
          {stories.length === 0 ? (
            <p class="empty">本期暂无</p>
          ) : (
            <div class="stories">
              {stories.map((story) => (
                <StoryItem story={story} />
              ))}
            </div>
          )}
        </section>
      );
    })
  }
  {
    (older || newer) && (
      <nav class="pager" aria-label="相邻刊期">
        {older ? (
          <a class="prev" href={href(editionPath(older))}>
            <small>较早一期</small>
            <span>
              {older.dateLabel}
              {older.editionLabel}
            </span>
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a class="next" href={href(editionPath(newer))}>
            <small>较新一期</small>
            <span>
              {newer.dateLabel}
              {newer.editionLabel}
            </span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</article>
