---
import { dayPath, getDays } from '../lib/editions';
import UiText from './UiText.astro';
import { href } from '../lib/urls';

const latest = getDays()[0];
---

<footer class="site-footer">
  <div class="wrap">
    <p class="footer-name">朝夕</p>
    <p>
      <UiText
        zh="每日一刊。上午在上，下午追加在同一份稿里。每条都有标题、摘要和来源。"
        en="One edition a day. Morning first; afternoon is appended to the same file. Every item has a title, a summary, and sources."
      />
    </p>
    <p>
      <a href={href('rss.xml')}>
        <UiText zh="订阅 RSS" en="RSS" />
      </a>
    </p>
    {
      latest && (
        <p class="fine">
          <UiText zh="最新一天：" en="Latest day: " />
          <a href={href(dayPath(latest))}>
            <UiText zh={latest.dateLabel} en={latest.dateLabelEn} />
          </a>
        </p>
      )
    }
  </div>
</footer>
