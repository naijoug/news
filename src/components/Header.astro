---
import { SECTIONS, sectionPath } from '../lib/editions';
import UiText from './UiText.astro';
import { href } from '../lib/urls';

interface Props {
  current?: 'home' | 'archive' | 'tech' | 'world' | 'business' | 'china';
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="wrap">
    <div class="masthead">
      <div class="identity">
        <a class="brand" href={href('/')}>
          <span class="seal" aria-hidden="true">日</span>
          <span class="logo-word">朝夕</span>
        </a>
        <p class="tagline">
          <UiText zh="每日一刊，上午与下午" en="One edition a day, morning and afternoon" />
        </p>
      </div>
      <div class="tools">
        <a href={href('rss.xml')}>RSS</a>
        <button type="button" class="theme-toggle" id="ui-toggle">
          <span class="ui-zh">EN</span>
          <span class="ui-en">中文</span>
        </button>
        <button type="button" class="theme-toggle" id="theme-toggle">深色</button>
      </div>
    </div>
    <nav aria-label="栏目">
      <ul class="nav-list">
        <li>
          <a href={href('archive/')} aria-current={current === 'archive' ? 'page' : undefined}>
            <UiText zh="归档" en="Archive" />
          </a>
        </li>
        {
          SECTIONS.map((section) => (
            <li>
              <a
                href={href(sectionPath(section.id))}
                aria-current={current === section.id ? 'page' : undefined}
              >
                <UiText zh={section.name.zh} en={section.name.en} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <script is:inline>
    (function () {
      var themeButton = document.getElementById('theme-toggle');
      var uiButton = document.getElementById('ui-toggle');
      var nav = document.querySelector('.site-header nav');

      function currentTheme() {
        return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      }
      function currentUi() {
        return document.documentElement.getAttribute('data-ui') === 'en' ? 'en' : 'zh';
      }
      function themeLabel(theme) {
        if (!themeButton) return;
        var ui = currentUi();
        var toDark = theme !== 'dark';
        if (ui === 'en') {
          themeButton.textContent = toDark ? 'Dark' : 'Light';
          themeButton.setAttribute('aria-label', toDark ? 'Switch to dark mode' : 'Switch to light mode');
        } else {
          themeButton.textContent = toDark ? '深色' : '浅色';
          themeButton.setAttribute('aria-label', toDark ? '切换到深色模式' : '切换到浅色模式');
        }
      }
      function applyUi(ui) {
        var root = document.documentElement;
        root.setAttribute('data-ui', ui);
        root.lang = ui === 'en' ? 'en' : 'zh-Hans';
        var title = ui === 'en' ? root.getAttribute('data-title-en') : root.getAttribute('data-title-zh');
        if (title) document.title = title;
        if (nav) nav.setAttribute('aria-label', ui === 'en' ? 'Sections' : '栏目');
        try {
          localStorage.setItem('ui-lang', ui);
        } catch (e) {}
        themeLabel(currentTheme());
        if (window.__zhaoxiSyncText) window.__zhaoxiSyncText();
      }

      themeLabel(currentTheme());
      if (themeButton) {
        themeButton.addEventListener('click', function () {
          var next = currentTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          themeLabel(next);
        });
      }
      if (uiButton) {
        uiButton.addEventListener('click', function () {
          applyUi(currentUi() === 'en' ? 'zh' : 'en');
        });
      }
      var media = window.matchMedia('(prefers-color-scheme: dark)');
      if (media.addEventListener) {
        media.addEventListener('change', function (event) {
          var stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch (e) {}
          if (stored === 'light' || stored === 'dark') return;
          var theme = event.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
          themeLabel(theme);
        });
      }
    })();
  </script>
</header>
