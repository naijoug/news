---
interface Props {
  href: string;
  sectionId: string;
  class?: string;
}

const { href, sectionId, class: className } = Astro.props;
const counter = globalThis as { __wash?: number };
counter.__wash = (counter.__wash ?? 0) + 1;
const fid = `wash-${sectionId}-${counter.__wash}`;

const body: Record<string, string> = {
  tech: 'M4 25C12 14 22 33 40 21C58 8 72 31 94 18C114 6 130 20 148 13C152 16 146 22 134 24C116 28 102 16 84 24C64 34 46 18 28 28C16 34 8 28 2 26C1 25 2 24 4 25Z',
  world: 'M3 22C14 10 26 30 48 17C68 5 86 28 108 16C126 7 140 18 152 14C155 18 146 24 132 23C112 22 98 14 80 22C60 32 42 16 24 26C12 32 6 26 2 23C1 22 2 21 3 22Z',
  business: 'M5 24C16 15 28 32 50 19C70 7 88 30 110 17C128 7 142 19 151 15C154 19 144 25 130 24C112 24 96 15 78 23C58 33 40 18 24 27C14 32 8 27 3 25C2 24 3 23 5 24Z',
  china: 'M3 23C10 11 24 32 44 18C64 5 82 29 106 15C126 4 142 16 153 12C156 17 146 23 132 22C114 22 98 13 78 22C58 32 40 17 22 27C12 33 6 27 2 24C1 23 2 22 3 23Z',
};
const core: Record<string, string> = {
  tech: 'M36 20C58 15 86 14 118 18C108 22 82 23 52 24C42 24 34 22 36 20Z',
  world: 'M32 18C56 13 90 12 122 17C110 21 80 22 48 23C38 23 30 20 32 18Z',
  business: 'M38 19C60 15 92 14 120 18C110 22 84 23 54 23C44 23 36 21 38 19Z',
  china: 'M30 18C54 13 88 12 124 16C112 21 78 22 46 23C36 23 28 20 30 18Z',
};
const edge: Record<string, string> = {
  tech: 'M22 27C44 32 70 24 96 29C118 33 136 26 150 28C140 31 118 34 92 31C66 28 44 34 22 30C18 29 18 27 22 27Z',
  world: 'M18 25C42 31 68 22 98 27C122 31 140 24 152 26C142 30 116 32 90 29C62 26 40 32 18 28C14 27 14 25 18 25Z',
  business: 'M24 26C48 32 74 23 102 28C124 32 140 25 151 27C140 31 114 33 88 30C62 27 42 33 24 29C20 28 20 26 24 26Z',
  china: 'M16 26C40 32 66 23 96 28C120 32 138 25 152 27C140 31 114 33 88 30C60 26 38 33 16 29C12 28 12 26 16 26Z',
};
---

<a class:list={['ink-label', `tag-${sectionId}`, className]} href={href}>
  <svg class="ink-wash" viewBox="0 0 156 44" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id={fid} x="-12%" y="-60%" width="128%" height="220%">
        <feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="2" seed={sectionId.length + 3} result="noise"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.6" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </defs>
    <g filter={`url(#${fid})`}>
      <path class="wash-body" d={body[sectionId] ?? body.tech}></path>
      <path class="wash-edge" d={edge[sectionId] ?? edge.tech}></path>
      <path class="wash-core" d={core[sectionId] ?? core.tech}></path>
      <path class="wash-tip" d="M128 12C140 8 152 12 158 14C150 15 140 15 130 16Z"></path>
      <path class="wash-tip wash-tip-b" d="M132 23C144 26 154 22 159 25C148 28 138 25 132 23Z"></path>
      <path class="wash-tip wash-tip-a" d="M2 22C8 18 12 26 6 28C3 27 1 24 2 22Z"></path>
    </g>
  </svg>
  <span class="ink-label-text"><slot /></span>
</a>
