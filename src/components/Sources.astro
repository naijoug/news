---
import type { Source } from '../lib/editions';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<p class="sources">
  <span class="sources-label">来源</span>
  {
    sources.map((source) => (
      <a href={source.url} target="_blank" rel="noopener noreferrer">
        {source.name}
        <span class="sr-only">（在新标签页打开）</span>
      </a>
    ))
  }
</p>
