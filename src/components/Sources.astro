---
import type { Source } from '../lib/editions';
import UiText from './UiText.astro';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<p class="sources">
  <span class="sources-label">
    <UiText zh="来源" en="Sources" />
  </span>
  {
    sources.map((source) => (
      <a href={source.url} target="_blank" rel="noopener noreferrer">
        {source.name}
        {source.lang === 'en' && <span class="source-lang">EN</span>}
        {source.lang === 'zh' && <span class="source-lang">中</span>}
        <span class="sr-only">
          <UiText zh="（在新标签页打开）" en=" (opens in a new tab)" />
        </span>
      </a>
    ))
  }
</p>
