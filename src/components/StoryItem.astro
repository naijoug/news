---
import type { Story } from '../lib/editions';
import Sources from './Sources.astro';

interface Props {
  story: Story;
}

const { story } = Astro.props;
---

<article class="story">
  <h3 class="story-title">{story.title}</h3>
  <p class="summary">{story.summary}</p>
  <Sources sources={story.sources} />
</article>
