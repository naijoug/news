---
import type { Lang } from '../lib/editions';

interface Props {
  originalLang: Lang;
  hasZh: boolean;
  hasEn: boolean;
}

const { originalLang, hasZh, hasEn } = Astro.props;
---

<span
  class="view-mark"
  data-original={originalLang}
  data-has-zh={hasZh ? '' : undefined}
  data-has-en={hasEn ? '' : undefined}
>
  <svg class="mark-original" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M3 1.2h6.2L13.2 5.1V14.8H3V1.2zm6.15.35.05 3.15h3.2zM4.55 7.35h5.3v.95h-5.3zm0 2.25h3.7v.95h-3.7z"
    ></path>
  </svg>
  <svg class="mark-translation" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10.1 2.3 13.5 5.1 10.1 7.9"></path>
      <path d="M13.3 5.1H2.7"></path>
      <path d="M5.9 8.1 2.5 10.9 5.9 13.7"></path>
      <path d="M2.7 10.9h10.6"></path>
    </g>
  </svg>
  <span class="sr-only showing-original">
    <span class="ui-zh">原文</span>
    <span class="ui-en">Original</span>
  </span>
  <span class="sr-only showing-translation">
    <span class="ui-zh">翻译</span>
    <span class="ui-en">Translation</span>
  </span>
</span>
