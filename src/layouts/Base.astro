---
import '@fontsource/fira-code/latin-400.css';
import '@fontsource/fira-code/latin-500.css';
import '@fontsource/fira-code/latin-600.css';
import '@fontsource/fira-code/latin-700.css';
import '@fontsource/fira-code/latin-ext-400.css';
import '@fontsource/fira-code/latin-ext-500.css';
import '@fontsource/fira-code/latin-ext-600.css';
import '@fontsource/fira-code/latin-ext-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absolute, href } from '../lib/urls';

interface Props {
  title: string;
  titleEn?: string;
  description: string;
  path: string;
  current?: 'home' | 'archive' | 'tech' | 'world' | 'business' | 'china';
  noindex?: boolean;
  prev?: string;
  next?: string;
}

const { title, titleEn = title, description, path, current, noindex = false, prev, next } = Astro.props;
const canonical = absolute(path);
const rss = absolute('rss.xml');
---

<!doctype html>
<html lang="zh-Hans" data-ui="zh" data-text="auto" data-title-zh={title} data-title-en={titleEn}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          root.setAttribute('data-theme', theme);
        } catch (e) {
          root.setAttribute('data-theme', 'light');
        }
        var ui = 'zh';
        var text = 'auto';
        try {
          var storedUi = localStorage.getItem('ui-lang');
          if (storedUi === 'en' || storedUi === 'zh') ui = storedUi;
          var storedText = localStorage.getItem('text-mode');
          if (storedText === 'original' || storedText === 'translation' || storedText === 'auto') {
            text = storedText;
          }
        } catch (e) {}
        root.setAttribute('data-ui', ui);
        root.setAttribute('data-text', text);
        root.lang = ui === 'en' ? 'en' : 'zh-Hans';
      })();
    </script>
    <style is:inline>
      html[data-theme='dark'] {
        background: #141311;
        color: #f4efe6;
      }
      html[data-theme='light'] {
        background: #f6f3eb;
        color: #211c18;
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var ui = root.getAttribute('data-ui');
        var nextTitle = ui === 'en' ? root.getAttribute('data-title-en') : root.getAttribute('data-title-zh');
        if (nextTitle) document.title = nextTitle;
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="朝夕" href={rss} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {prev && <link rel="prev" href={prev} />}
    {next && <link rel="next" href={next} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="theme-color" content="#f6f3eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a class="skip" href="#main">
      <span class="ui-zh">跳到正文</span>
      <span class="ui-en">Skip to content</span>
    </a>
    <Header current={current} />
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
    <script is:inline>
      (function () {
        function viewingTranslation(toggle) {
          var root = document.documentElement;
          var text = root.getAttribute('data-text') || 'auto';
          var ui = root.getAttribute('data-ui') || 'zh';
          var original = toggle.getAttribute('data-original');
          var hasZh = toggle.hasAttribute('data-has-zh');
          var hasEn = toggle.hasAttribute('data-has-en');
          if (text === 'original') return false;
          if (text === 'translation') return original === 'en' ? hasZh : hasEn;
          if (ui === 'en') return hasEn && original === 'zh';
          return hasZh && original === 'en';
        }
        function sync() {
          document.querySelectorAll('.text-toggle').forEach(function (toggle) {
            var translated = viewingTranslation(toggle);
            var originalBtn = toggle.querySelector('[data-mode="original"]');
            var translationBtn = toggle.querySelector('[data-mode="translation"]');
            if (originalBtn) originalBtn.setAttribute('aria-pressed', translated ? 'false' : 'true');
            if (translationBtn) translationBtn.setAttribute('aria-pressed', translated ? 'true' : 'false');
          });
        }
        window.__zhaoxiSyncText = sync;
        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || !target.closest) return;
          var button = target.closest('.text-toggle [data-mode]');
          if (!button) return;
          var mode = button.getAttribute('data-mode');
          if (mode !== 'original' && mode !== 'translation') return;
          document.documentElement.setAttribute('data-text', mode);
          try {
            localStorage.setItem('text-mode', mode);
          } catch (e) {}
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
