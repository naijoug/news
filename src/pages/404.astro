---
import Base from '../layouts/Base.astro';
import UiText from '../components/UiText.astro';
---

<Base title="朝夕 · 未找到" titleEn="朝夕 · Not found" description="这一页不在朝夕的刊例里。" path="404.html" noindex>
  <header class="page-head">
    <p class="eyebrow">404</p>
    <h1>
      <UiText zh="未找到" en="Not found" />
    </h1>
    <p class="dek">
      <UiText zh="这一页不在刊例里。" en="This page is not in the index." />
    </p>
  </header>
  <p class="empty">
    <a href={import.meta.env.BASE_URL}>
      <UiText zh="返回首页" en="Back to the homepage" />
    </a>
  </p>
</Base>
