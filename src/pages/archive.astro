---
import Base from '../layouts/Base.astro';
import UiText from '../components/UiText.astro';
import { dayPath, getDays, groupByMonth, hasRealDay, partStoryCount } from '../lib/editions';
import { href } from '../lib/urls';

const days = getDays();
const months = groupByMonth(days);
---

<Base
  title="朝夕 · 归档"
  titleEn="朝夕 · Archive"
  description="按日期回看朝夕。同一天里，上午在上，下午在下。"
  path="archive/"
  current="archive"
  noindex={!hasRealDay(days)}
>
  <header class="page-head">
    <p class="eyebrow">
      <UiText zh="刊例" en="Index" />
    </p>
    <h1>
      <UiText zh="归档" en="Archive" />
    </h1>
    <p class="dek">
      <UiText
        zh="一天一份。打开后，上午在上，下午在下。"
        en="One file a day. Morning is on top, afternoon below."
      />
    </p>
  </header>
  {
    months.map((month) => (
      <section class="month">
        <h2>
          <UiText zh={month.label} en={month.labelEn} />
        </h2>
        <ol class="days">
          {month.days.map((day) => (
            <li class="day">
              <time datetime={day.date}>
                <a href={href(dayPath(day))}>
                  <UiText zh={day.dayLabel} en={day.dayLabelEn} />
                </a>
                <span>
                  <UiText zh={day.weekday} en={day.weekdayEn} />
                </span>
              </time>
              <div class="day-links">
                <a href={href(dayPath(day))}>
                  <UiText zh={`${day.storyCount} 则`} en={`${day.storyCount} stories`} />
                </a>
                {partStoryCount(day, 'am') > 0 && (
                  <a href={href(`${dayPath(day)}#am`)}>
                    <UiText zh="上午" en="Morning" />
                  </a>
                )}
                {partStoryCount(day, 'pm') > 0 && (
                  <a href={href(`${dayPath(day)}#pm`)}>
                    <UiText zh="下午" en="Afternoon" />
                  </a>
                )}
                {day.sample && (
                  <span class="pill">
                    <UiText zh="示例" en="Sample" />
                  </span>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>
