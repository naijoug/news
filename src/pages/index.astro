---
import Base from '../layouts/Base.astro';
import DayDocument from '../components/DayDocument.astro';
import { dayDescription, dayPath, getDays } from '../lib/editions';
import { href } from '../lib/urls';

const days = getDays();
const latest = days[0];
const older = days[1] ?? null;
if (!latest) throw new Error('No days to render');
---

<Base
  title={`朝夕 · ${latest.dateLabel}`}
  titleEn={`Zhaoxi · ${latest.dateLabelEn}`}
  description={dayDescription(latest)}
  path="/"
  current="home"
  noindex={latest.sample}
  prev={older ? href(dayPath(older)) : undefined}
>
  <DayDocument day={latest} older={older} showPermalink />
</Base>
