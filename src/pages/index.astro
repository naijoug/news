---
import Base from '../layouts/Base.astro';
import DayIndex from '../components/DayIndex.astro';
import UiText from '../components/UiText.astro';
import { getDays, hasRealDay } from '../lib/editions';

const days = getDays();
if (days.length === 0) throw new Error('No days to render');
---

<Base
  title="朝夕 · 每日新闻"
  titleEn="朝夕 · Daily News"
  description="朝闻道，夕死可矣！ If one hears the Way in the morning, one may die content in the evening."
  path="/"
  current="home"
  noindex={!hasRealDay(days)}
>
  <header class="page-head index-head">
    <svg class="ink-mountains" viewBox="0 0 800 128" aria-hidden="true">
      <defs>
        <linearGradient id="ridge-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="currentColor" stop-opacity="0.34"></stop>
          <stop offset="0.42" stop-color="currentColor" stop-opacity="0.12"></stop>
          <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="far" fill="url(#ridge-wash)" d="M0 78C70 70 90 46 150 52C210 58 230 28 300 36C370 44 400 18 470 30C540 42 570 22 640 34C700 44 740 30 800 40V128H0Z"></path>
      <path class="mid" fill="url(#ridge-wash)" d="M0 92C90 84 120 58 190 66C260 74 290 48 360 58C430 68 470 46 540 58C610 70 650 50 720 62C760 68 780 58 800 64V128H0Z"></path>
      <path class="near" fill="url(#ridge-wash)" d="M0 108C80 100 140 78 210 86C290 96 330 74 410 84C490 94 540 76 620 88C690 98 740 82 800 92V128H0Z"></path>
      <path class="ridge" d="M0 86C80 74 130 48 200 58C270 68 310 40 380 52C450 64 500 38 580 52C650 64 710 46 800 58"></path>
    </svg>
    <p class="eyebrow">
      <UiText zh="册页" en="Leaves" />
    </p>
    <h1>
      <UiText zh="每日新闻" en="Daily News" />
    </h1>
    <p class="dek">
      <UiText
        zh="点开日期，看这一天的上午和下午。"
        en="Open a date for that morning and afternoon."
      />
    </p>
  </header>
  <DayIndex days={days} />
</Base>
