---
import Base from '../layouts/Base.astro';
import DayIndex from '../components/DayIndex.astro';
import UiText from '../components/UiText.astro';
import { getDays, hasRealDay } from '../lib/editions';

const days = getDays();
if (days.length === 0) throw new Error('No days to render');
---

<Base
  title="朝夕 · 每日新闻"
  titleEn="朝夕 · Daily News"
  description="朝闻道，夕死可矣！ If one hears the Way in the morning, one may die content in the evening."
  path="/"
  current="home"
  noindex={!hasRealDay(days)}
>
  <header class="page-head index-head">
    <svg class="ink-mountains" viewBox="0 0 800 128" aria-hidden="true">
      <defs>
        <linearGradient id="ridge-wash" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="currentColor" stop-opacity="0.42"></stop>
          <stop offset="0.42" stop-color="currentColor" stop-opacity="0.12"></stop>
          <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="far" fill="url(#ridge-wash)" d="M0 86 L70 78 L120 52 L180 74 L250 34 L320 70 L390 28 L470 66 L540 40 L610 72 L680 46 L760 68 L800 58 V128 H0 Z"></path>
      <path class="mid" fill="url(#ridge-wash)" d="M0 98 L90 88 L150 64 L230 82 L300 50 L380 78 L460 46 L540 80 L620 58 L710 84 L800 70 V128 H0 Z"></path>
      <path class="near" fill="url(#ridge-wash)" d="M0 112 L100 102 L170 84 L250 100 L340 78 L430 104 L520 82 L620 106 L710 88 L800 98 V128 H0 Z"></path>
      <path class="ridge" d="M0 90 L80 80 L140 48 L210 76 L280 36 L360 74 L440 32 L530 70 L600 44 L690 76 L800 56"></path>
    </svg>
    <p class="eyebrow">
      <UiText zh="册页" en="Leaves" />
    </p>
    <h1>
      <UiText zh="每日新闻" en="Daily News" />
    </h1>
    <p class="dek">
      <UiText
        zh="点开日期，看这一天的上午和下午。"
        en="Open a date for that morning and afternoon."
      />
    </p>
  </header>
  <DayIndex days={days} />
</Base>
