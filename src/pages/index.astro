---
import Base from '../layouts/Base.astro';
import EditionView from '../components/EditionView.astro';
import { editionDescription, editionPath, getEditions } from '../lib/editions';
import { href } from '../lib/urls';

const editions = getEditions();
const latest = editions[0];
const older = editions[1] ?? null;
if (!latest) {
  throw new Error('No editions to render');
}
const description = editionDescription(latest);
---

<Base
  title={`朝夕 · ${latest.dateLabel}${latest.editionLabel}`}
  description={description}
  path="/"
  current="home"
  noindex={latest.sample}
  prev={older ? href(editionPath(older)) : undefined}
>
  <EditionView edition={latest} older={older} newer={null} showPermalink />
</Base>
