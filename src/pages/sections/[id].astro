---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import UiText from '../../components/UiText.astro';
import {
  SECTIONS,
  dayPath,
  getDays,
  sectionPath,
  type Day,
  type SectionInfo,
  type Story,
} from '../../lib/editions';
import { href } from '../../lib/urls';

interface Group {
  day: Day;
  stories: Story[];
}

export function getStaticPaths() {
  const days = getDays();
  return SECTIONS.map((section) => ({
    params: { id: section.id },
    props: {
      section,
      groups: days
        .map((day) => ({
          day,
          stories: day.stories.filter((story) => story.sectionId === section.id),
        }))
        .filter((group) => group.stories.length > 0),
    },
  }));
}

interface Props {
  section: SectionInfo;
  groups: Group[];
}

const { section, groups } = Astro.props;
const indexable = groups.some((group) => !group.day.sample);
---

<Base
  title={`${section.name.zh} · 朝夕`}
  titleEn={`${section.name.en} · Zhaoxi`}
  description={`${section.name.zh}：${section.description.zh}`}
  path={sectionPath(section.id)}
  current={section.id as 'tech' | 'world' | 'business' | 'china'}
  noindex={!indexable}
>
  <header class="page-head">
    <p class="eyebrow">
      <UiText zh="栏目" en="Section" />
    </p>
    <h1>
      <UiText zh={section.name.zh} en={section.name.en} />
    </h1>
    <p class="dek">
      <UiText zh={section.description.zh} en={section.description.en} />
    </p>
  </header>
  {
    groups.length === 0 ? (
      <p class="empty">
        <UiText zh="这一栏还没有条目。" en="Nothing in this section yet." />
      </p>
    ) : (
      groups.map((group) => (
        <section class="section-group">
          <h2>
            <a href={href(dayPath(group.day))}>
              <UiText zh={group.day.dateLabel} en={group.day.dateLabelEn} />
            </a>
            {group.day.sample && (
              <span class="pill">
                <UiText zh="示例" en="Sample" />
              </span>
            )}
          </h2>
          <div class="card-grid">
            {group.stories.map((story) => (
              <StoryCard story={story} showSection={false} />
            ))}
          </div>
        </section>
      ))
    )
  }
</Base>
